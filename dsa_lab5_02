#include <stdio.h>
#include <stdlib.h>

/* ===== CIRCULAR LINKED LIST NODE ===== */
struct Node {
    int data;
    struct Node* next;
};

/* Create node */
struct Node* createNode(int data) {
    struct Node* n = (struct Node*)malloc(sizeof(struct Node));
    n->data = data;
    n->next = n;
    return n;
}

/* Insert at end */
struct Node* insertEnd(struct Node* head, int data) {
    struct Node* n = createNode(data);

    if (head == NULL)
        return n;

    struct Node* temp = head;
    while (temp->next != head)
        temp = temp->next;

    temp->next = n;
    n->next = head;
    return head;
}

/* Display list */
void display(struct Node* head) {
    struct Node* temp = head;
    if (!head) return;

    do {
        printf("%d → ", temp->data);
        temp = temp->next;
    } while (temp != head);

    printf("(back to %d)\n", head->data);
}

/* 1. Split circular list */
void splitList(struct Node* head, struct Node** h1, struct Node** h2) {
    struct Node *slow = head, *fast = head;

    while (fast->next != head && fast->next->next != head) {
        slow = slow->next;
        fast = fast->next->next;
    }

    *h1 = head;
    *h2 = slow->next;

    fast->next = slow->next;
    slow->next = head;
}

/* 2. Check if sorted */
int isSorted(struct Node* head) {
    struct Node* temp = head;
    do {
        if (temp->next != head && temp->data > temp->next->data)
            return 0;
        temp = temp->next;
    } while (temp != head);
    return 1;
}

/* 3. Insert into sorted circular list */
struct Node* insertSorted(struct Node* head, int data) {
    struct Node* n = createNode(data);

    if (!head)
        return n;

    struct Node* curr = head;
    while (curr->next != head && curr->next->data < data)
        curr = curr->next;

    n->next = curr->next;
    curr->next = n;
    return head;
}

/* 4. Reverse circular list */
struct Node* reverse(struct Node* head) {
    struct Node *prev = NULL, *curr = head, *next;
    struct Node* start = head;

    do {
        next = curr->next;
        curr->next = prev;
        prev = curr;
        curr = next;
    } while (curr != start);

    start->next = prev;
    return prev;
}

/* 5. Delete every k-th node */
int deleteKth(struct Node* head, int k) {
    struct Node* curr = head;

    while (curr->next != curr) {
        for (int i = 1; i < k - 1; i++)
            curr = curr->next;

        struct Node* temp = curr->next;
        curr->next = temp->next;
        free(temp);
    }
    return curr->data;
}

/* ===== MAIN ===== */
int main() {
    struct Node* head = NULL;

    head = insertEnd(head, 1);
    head = insertEnd(head, 2);
    head = insertEnd(head, 3);
    head = insertEnd(head, 4);
    head = insertEnd(head, 5);

    printf("Original Circular List:\n");
    display(head);

    /* 1. Split circular list */
    struct Node *h1 = NULL, *h2 = NULL;
    splitList(head, &h1, &h2);

    printf("\nFirst Half:\n");
    display(h1);

    printf("Second Half:\n");
    display(h2);

    /* 2. Check if sorted */
    printf("\nIs First Half Sorted?\n");
    if (isSorted(h1))
        printf("YES\n");
    else
        printf("NO\n");

    /* 3. Insert into sorted circular list */
    printf("\nAfter inserting 3 into First Half:\n");
    h1 = insertSorted(h1, 3);
    display(h1);

    /* 4. Reverse circular list */
    printf("\nReversed First Half:\n");
    h1 = reverse(h1);
    display(h1);

    /* 5. Delete every k-th node */
    printf("\nRemaining node after deleting every 2nd node:\n");
    printf("%d\n", deleteKth(head, 2));

    return 0;
}
