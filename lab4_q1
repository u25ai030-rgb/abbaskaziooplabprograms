public class MatrixMapping {
    static int sizeX = 3;
    static int sizeY = 3;
    static int sizeZ = 3;

    public static void set(int value, int indexX, int indexY, int indexZ, int[] array1D) {
        int flatIndex = (indexX * sizeY * sizeZ) + (indexY * sizeZ) + indexZ;
        array1D[flatIndex] = value;
    }

    public static int get(int indexX, int indexY, int indexZ, int[] array1D) {
        int flatIndex = (indexX * sizeY * sizeZ) + (indexY * sizeZ) + indexZ;
        return array1D[flatIndex];
    }

    public static void main(String[] args) {
        int[] myArray = new int[sizeX * sizeY * sizeZ];
        set(50, 1, 2, 1, myArray);
        System.out.println(get(1, 2, 1, myArray));
    }
}
