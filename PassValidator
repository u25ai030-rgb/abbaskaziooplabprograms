import java.util.Scanner;
public class PassValidator {

    public static boolean isValid(String password) {
        int len = password.length();
        if (len < 5 || len > 12) return false;  // Rule 3

        boolean hasLower = false;
        boolean hasDigit = false;

        // Rule 1 & 2: check each character
        for (int i = 0; i < len; i++) {
            char c = password.charAt(i);
            if (c >= 'a' && c <= 'z') {
                hasLower = true;
            } else if (c >= '0' && c <= '9') {
                hasDigit = true;
            } else {
                // Invalid character: uppercase or special
                return false;
            }
        }

        if (!hasLower || !hasDigit) return false; // Must have at least one lowercase and one digit

        // Rule 4: No immediate repeated patterns
        for (int patternLen = 1; patternLen <= len / 2; patternLen++) {
            for (int i = 0; i + 2 * patternLen <= len; i++) {
                String sub1 = password.substring(i, i + patternLen);
                String sub2 = password.substring(i + patternLen, i + 2 * patternLen);
                if (sub1.equals(sub2)) {
                    return false; // immediate repeated pattern found so false
                }
            }
        }

        return true; // All checks passed
    }

    // Demo
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter password to be checked.");
        String test = sc.nextLine();
        System.out.println(test + ": " + (isValid(test) ? "Valid" : "Invalid"));
    }
}


