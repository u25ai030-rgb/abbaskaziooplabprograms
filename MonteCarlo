class MonteCarlo {

    public static void main(String[] args) {

        final int TOTAL_THROWS = 1000000;
        int count = 0;
        double x, y;

        for (int i = 0; i < TOTAL_THROWS; i++) {

            // Random point in square [-1,1] x [-1,1]
            x = Math.random() * 2 - 1;
            y = Math.random() * 2 - 1;

            // CONDITIONS FOR Odd-numbered regions: 1 and 3
            if (x < 0) {
                count++;
            }
            else if (x > 0 && y > 0 && (x + y) < 1) {
                count++;
            }
        }

        double probability = count / (double) TOTAL_THROWS;
        System.out.println("Probability = " + probability);
    }
}

